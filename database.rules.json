{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || data.child('status').val() === 'lobby')",
        "players": {
          "$uid": { ".write": "auth != null && auth.uid === $uid || root.child('rooms/'+$code+'/host').val() === auth.uid" }
        }
      }
    }
  }
}
