{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".indexOn": [
        "matchKey"
      ],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || data.child('status').val() === 'lobby')",
        "bet": {
          ".validate": "newData.isNumber() && (newData.val() === 5 || newData.val() === 10 || newData.val() === 20 || newData.val() === 50 || newData.val() === 100)"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid || root.child('rooms/'+$code+'/host').val() === auth.uid"
          }
        }
      }
    }
  }
}
