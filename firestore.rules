rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.uid in ['y2KNKyXttQa4S8p0ON2c6xXCcJd2']; } // same UID as ADMIN_UIDS in index.html
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Cash-out is only allowed on Sundays in Philippine time (UTC+8). Epoch day 3 is a Sunday, so day - 7*week == 3 means Sunday.
    function phSunday() {
      let ms = request.time.toMillis() + 28800000;
      return math.floor(ms / 86400000) - 7 * math.floor(ms / 604800000) == 3;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.coins == 0;
      // Players may spend coins freely but gain at most 200 per write (largest prize: 100-coin bet x2).
      // DEMO ONLY: move prize payouts to a Cloud Function before taking real money.
      allow update: if isAdmin() || (isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins','gender','matches','wins','won','rp'])
        && request.resource.data.coins >= 0
        && request.resource.data.coins - resource.data.coins <= 200);
    }

    match /transactions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (isOwner(request.resource.data.uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['deposit', 'withdrawal']
        && (request.resource.data.type != 'withdrawal' || phSunday()));
      allow update: if isAdmin();
    }

    match /chats/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      match /messages/{m} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) && request.resource.data.from == 'player') || isAdmin();
      }
    }
    // The admin's chat-thread list reads /chats as a collection.
    match /chats/{uid} { allow list: if isAdmin(); }

    // Coin value and withdrawal fee. Anyone can read it (the How to play window shows it), only the admin can change it.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
